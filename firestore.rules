rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check user role
    function getRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role;
    }

    function isAdmin() {
      return request.auth != null && getRole() == "admin";
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile; admins can read all
      allow read: if request.auth != null && (isOwner(userId) || isAdmin());
      // Users can create their own profile during registration
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users can update their own profile; admins can update anyone
      allow update: if request.auth != null && (isOwner(userId) || isAdmin());
      // Only admins can delete users
      allow delete: if isAdmin();

      // Subcollections for borrowed/returned items
      match /borrowed/{transactionId} {
        allow read: if request.auth != null && (isOwner(userId) || isAdmin());
        allow write: if request.auth != null && isAdmin();
      }
      match /returned/{transactionId} {
        allow read: if request.auth != null && (isOwner(userId) || isAdmin());
        allow write: if request.auth != null && isAdmin();
      }
    }

    // Admins collection (legacy - restrict to admin only)
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Catalog - anyone authenticated can read; admin can write
    match /catalog/{itemId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Transactions - admins can read/write all
    match /transactions/{transactionId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null;
      allow update: if request.auth != null && isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications - users can read their own; admins can manage all
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Documents - admin can manage
    match /documents/{docId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if isAdmin();
    }

    // Maintenance - admin can manage
    match /maintenance/{id} {
      allow read: if request.auth != null && isAdmin();
      allow write: if isAdmin();
    }

    // Incidents - anyone can read; anyone can create; admin can update
    match /incidents/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && isAdmin();
      allow delete: if isAdmin();
    }

    // Manuals - anyone authenticated can read; admin can manage
    match /manuals/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Fines - admin can manage all
    match /fines/{id} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null;
      allow update: if request.auth != null && isAdmin();
      allow delete: if isAdmin();
    }

    // Borrow Requests - anyone can create/read own; admin can manage
    match /borrowRequests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && isAdmin();
      allow delete: if isAdmin();
    }

    // Backups - admin only
    match /backups/{id} {
      allow read, write: if isAdmin();
    }

    // Settings - admin only
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Lab Activities - anyone authenticated can read; admin can manage
    match /labActivities/{activityId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Lab Attendance - public kiosk can read/create; admin can manage
    match /labAttendance/{attendanceId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Lab Rooms - anyone authenticated can read; admin can manage
    match /labRooms/{roomId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}
