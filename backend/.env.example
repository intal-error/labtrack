# Firebase Admin SDK (download service account key from Firebase Console)
# Used for Auth + user profile lookups (users/admins stay in Firebase)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_API_KEY=your_web_api_key

# Supabase (PostgreSQL database for all application data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Server
PORT=5000
NODE_ENV=development

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@slsu-labtrack.com

# Client URL (for CORS) - comma-separated for multiple origins
# Production: CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173
