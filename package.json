{
  "name": "labtrack",
  "version": "1.0.0",
  "description": "SLSU LabTrack v4 - React + Node.js",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev:all": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
